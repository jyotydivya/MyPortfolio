# ==============================================================================
# Comprehensive .gitignore for Next.js, TypeScript & React Projects
# Portfolio: Divya Jyoty (https://github.com/jyotydivya)
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js Build Output & Cache
/.next/
/out/
/build
/dist
.next/cache/

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
*.log

# Environment Variables & Secrets
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# Vercel Deployment Metadata
.vercel

# TypeScript Build Info & Next Type Definitions
*.tsbuildinfo
next-env.d.ts

# Testing & Code Coverage
/coverage
*.lcov
.nyc_output

# OS-Specific Artifacts
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editor & IDE Files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj

# Temporary & Cache Directories
*.tmp
*.temp
.cache/